{
  "name": "zimo-web",
  "version": "10.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib src tools",
    "predev": "node prebuild-helper/prebuild.js",
    "typecheck": "tsc -p tsconfig.src.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:spelling": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/lint-spelling.ts",
    "themes:migrate": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tools/register.mjs tools/migrate-themes.ts",
    "themes:css": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tools/register.mjs tools/build-theme-css.ts",
    "themes:check": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tools/register.mjs tools/build-theme-css.ts --check",
    "themes:verify": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tools/register.mjs tools/verify-theme-properties.ts",
    "lint:css": "node tools/check-css.mjs",
    "docs:migrate": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tools/register.mjs tools/migrate-documents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@react-oauth/google": "^0.11.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "color-convert": "^3.1.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.21",
    "glob": "^11.0.3",
    "google-auth-library": "^10.6.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "html-escaper": "^3.0.3",
    "immer": "^11.1.18",
    "jose": "^6.2.7",
    "lodash": "^4.17.21",
    "marked": "^12.0.2",
    "marked-katex-extension": "^5.1.8",
    "micromark": "^4.0.2",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "next": "^16.2.12",
    "node-vibrant": "^4.0.4",
    "react": "19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.0",
    "react-masonry-css": "^1.0.16",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html-escaper": "^3.0.3",
    "@types/katex": "^0.16.8",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.185.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expect-type": "^1.4.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
